{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kuratchi-orm-test-worker",
  "main": "./fixture-worker.ts",
  "compatibility_date": "2024-12-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kuratchi-orm-test",
      "database_id": "kuratchi-orm-test-id"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "TEST_DO",
        "class_name": "TestDO"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["TestDO"]
    }
  ]
}
